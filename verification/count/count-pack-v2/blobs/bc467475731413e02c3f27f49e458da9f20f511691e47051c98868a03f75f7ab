"""Fixed exact acceptance of the guarded fixed-n35, K=0 count comparison.
Does not import discovery. Every split is reconstructed; every leaf is replayed.
"""
from fractions import Fraction as F
from pathlib import Path
from hashlib import sha256
from copy import deepcopy
import json,re,sys,time
from exact_bridge_quartic_core import cell_bridge,CE_LO
from variance_geometry import need
HERE=Path(__file__).parent
TARGET=CE_LO
from profile import EXPECTED,N,FIRST,LAST
FIELDS=set(EXPECTED)
def fixed(index):return EXPECTED['rows'][index-FIRST]
def unique_pairs(pairs):
 out={}
 for k,v in pairs:
  need(k not in out,'duplicate JSON key');out[k]=v
 return out
def parse(raw):return json.loads(raw,object_pairs_hook=unique_pairs)
def rational(x):
 need(type(x)is str and re.fullmatch(r'-?[0-9]+(?:/[1-9][0-9]*)?',x) is not None,'typed rational')
 v=F(x);need(str(v)==x,'canonical rational');return v
def contract(raw):
 o=parse(raw);need(type(o)is dict and set(o)==FIELDS,'contract fields')
 need(type(o['n'])is int and all(type(r['index'])is int for r in o['rows']),'typed indices')
 need(all(o[k]==v for k,v in EXPECTED.items()),'fixed guarded contract')
 need(type(o['premise'])is str,'contract premise')
 for i,r in enumerate(o['rows'],FIRST):
  need(type(r['index'])is int and r['index']==i and type(r['n'])is int and r['n']==N,'typed row identity')
  pl,pu=map(F,r['p']);d=F(r['d0']);need(pl==F(i,100)and pu==F(i+1,100),'contiguous p panels')
  need(0<d<min(pl,1-pu,F(1,4)),'actual small central-gap scope')
  need(all(0<F(r[k])<1 for k in('outer0','outer1')),'positive bounded outward support')
  need(all(F(r[k])>0 for k in('Lambda','D','radius_minus','radius_plus','Hminus','Hplus')),'positive resources')
  need(all(F(q['Qbudget'])>0 for q in r['quadratics']),'positive phase price')
  need(F(r['binary_charge'])>=0 and F(r['gap_charge'])>0 and F(r['noise_charge'])>0,'actual affine defect charge')
  need(F(1,4)+F(r['Lambda'])/N<1 and N*pl-F(r['Hminus'])>0 and N*pu+F(r['Hplus'])<N,'all nearest counts covered')
 return sha256(raw).hexdigest()
RAW=(HERE/'contract.json').read_bytes();CONTRACT_HASH=contract(RAW)
def key(o):
 need(type(o)is dict and type(o.get('k'))is int and 0<=o['k']<=N,'typed count')
 path=o.get('path');need(type(path)is list and len(path)<=75 and all(type(v)is int and v in(0,1)for v in path),'typed binary path')
 return o['k'],tuple(path)
def structure(o,index):
 need(type(index)is int and FIRST<=index<=LAST,'fixed p panel')
 need(type(o)is dict and set(o)=={'schema','contract_sha256','index','root','splits','leaves','visited','maximum_score','target_lower','status'},'candidate fields')
 need(o['schema']=='EXACT_BRIDGE38_HYBRID_QUARTIC_ROW_V6' and o['status']=='EXACT_CONSTRUCTION_COMPLETE','candidate version')
 need(type(o['index'])is int and o['index']==index,'candidate panel')
 need(o['contract_sha256']==CONTRACT_HASH,'contract binding')
 need(rational(o['target_lower'])==TARGET,'fixed positive barrier')
 FIX=fixed(index)
 start=[[F(index,100),F(index+1,100)],[F(0),F(FIX['Lambda'])],[F(0),F(1)],[-F(1,2),F(1,2)],[F(0),F(FIX['d0'])]]
 need(o['root']==[[str(x)for x in a]for a in start],'fixed closed root')
 need(type(o['splits'])is list and type(o['leaves'])is list and o['leaves'],'node lists')
 splits={};leaves={}
 for pos,node in enumerate(o['splits']):
  need(type(node)is dict and set(node)=={'k','path','axis'},'split fields');kk=key(node)
  need(type(node['axis'])is int and 0<=node['axis']<=4,'typed split axis')
  need(kk not in splits,'duplicate split');splits[kk]=(pos,node)
 for pos,node in enumerate(o['leaves']):
  need(type(node)is dict and set(node)=={'k','path','status','score_upper'},'leaf fields');kk=key(node)
  need(kk not in leaves and kk not in splits,'duplicate/overlapping leaf')
  need(node['status'] in('EMPTY_PHASE','EMPTY_NEGATIVE_BUDGET','EMPTY_SUPPORT_VARIANCE','EMPTY_SHARP_GAP','EMPTY_VARIANCE_IDENTITY','EMPTY_PHASE_RESOURCE','PASS_BELOW_CE'),'leaf status')
  if node['status']=='PASS_BELOW_CE':need(0<=rational(node['score_upper'])<TARGET,'recorded score reserve')
  else:need(node['score_upper']is None,'empty cell score')
  leaves[kk]=(pos,node)
 si=li=0;contexts=[]
 for k in range(N+1):
  stack=[([],deepcopy(start))]
  while stack:
   path,b=stack.pop();kk=(k,tuple(path))
   if kk in splits:
    pos,node=splits[kk];need(pos==si,'split canonical order');si+=1
    axis=node['axis'];mid=sum(b[axis])/2
    need(b[axis][0]<mid<b[axis][1],'nonempty split')
    for side in(1,0):
     bb=deepcopy(b);bb[axis][1-side]=mid;stack.append((path+[side],bb))
   else:
    need(kk in leaves,'missing closed branch/count')
    pos,node=leaves[kk];need(pos==li,'leaf canonical order');li+=1
    contexts.append((k,b,node))
 need(si==len(splits) and li==len(leaves),'unused/extra nodes')
 need(type(o['visited'])is int and o['visited']==si+li,'visited node count')
 maximum=max((rational(z['score_upper'])for z in o['leaves']if z['status']=='PASS_BELOW_CE'),default=F(0))
 need(rational(o['maximum_score'])==maximum,'recorded maximum')
 return contexts

def check_leaf(index,k,b,node):
 out=cell_bridge(fixed(index),pl=b[0][0],pu=b[0][1],lo=b[1][0],hi=b[1][1],al=b[2][0],ah=b[2][1],k=k,ul=b[3][0],uh=b[3][1],a0l=b[4][0],a0h=b[4][1])
 if 'score_upper'in out:
  need(F(out['score_upper'])<TARGET,'strict recomputed positive barrier')
  need(node['status']=='PASS_BELOW_CE' and node['score_upper']==out['score_upper'],'recomputed leaf score/status')
  return F(out['score_upper'])
 need(out['status']==node['status'],'recomputed empty region')
 return F(0)

def controls(o,index,contexts):
 controls=0
 def rejects(f):
  nonlocal controls
  try:f()
  except(ValueError,TypeError,KeyError,IndexError):controls+=1;return
  raise ValueError('mutation unexpectedly accepted')
 def mutate(f):
  z=deepcopy(o);f(z);rejects(lambda:structure(z,index))
 mutate(lambda z:z['leaves'].append(deepcopy(z['leaves'][0])))
 mutate(lambda z:z['leaves'].pop())
 mutate(lambda z:z['leaves'].reverse())
 mutate(lambda z:z['leaves'][0].update(k=True))
 mutate(lambda z:z.update(index=True))
 mutate(lambda z:z.update(contract_sha256='0'*64))
 mutate(lambda z:z.update(target_lower='1'))
 mutate(lambda z:z.update(unknown=0))
 if o['splits']:mutate(lambda z:z['splits'][0].update(axis=True))
 else:mutate(lambda z:z['splits'].append(dict(k=0,path=[],axis=True)))
 t=next((i for i,x in enumerate(o['leaves'])if x['path']),None)
 if t is None:mutate(lambda z:z['leaves'][0].update(path=[True]))
 else:mutate(lambda z:z['leaves'][t]['path'].__setitem__(0,True))
 c=parse(RAW);c['rows'][0]['outer0']='4/5';rejects(lambda:contract(json.dumps(c).encode()))
 for field in ('binary_charge','gap_charge','noise_charge'):
  c=parse(RAW);c['rows'][0][field]='999';rejects(lambda:contract(json.dumps(c).encode()))
 c=parse(RAW);c['premise']='Unlinked independent resources';rejects(lambda:contract(json.dumps(c).encode()))
 positive=next((x for x in contexts if x[2]['status']=='PASS_BELOW_CE' and F(x[2]['score_upper'])>0),None)
 if positive is not None:
  k,b,node=positive
  false=deepcopy(node);false['score_upper']='0';rejects(lambda:check_leaf(index,k,b,false))
  false=deepcopy(node);false['status']='EMPTY_PHASE';false['score_upper']=None;rejects(lambda:check_leaf(index,k,b,false))
 else:
  k,b,node=contexts[0]
  false=deepcopy(node)
  if node['status']=='PASS_BELOW_CE':false['score_upper']='1/100'
  else:false['status']='PASS_BELOW_CE';false['score_upper']='0'
  rejects(lambda:check_leaf(index,k,b,false))
  mutate(lambda z:z.update(maximum_score='01/100'))
 rejects(lambda:parse('{"index":31,"index":31}'))
 rejects(lambda:contract('{"n":32,"n":32}'))
 return controls

def main():
 need(__debug__ and not sys.flags.optimize,'ordinary Python required')
 need(len(sys.argv)==2 and sys.argv[1].isdigit(),'one panel argument')
 index=int(sys.argv[1]);path=HERE/f'candidate_{index}.json';raw=path.read_bytes();o=parse(raw);contexts=structure(o,index)
 began=time.monotonic();maximum=F(0);passed=empty=0
 for i,(k,b,node)in enumerate(contexts):
  maximum=max(maximum,check_leaf(index,k,b,node))
  if node['status']=='PASS_BELOW_CE':passed+=1
  else:empty+=1
  if i and i%1000==0:print('REPLAY',index,i,len(contexts),flush=True)
 nc=controls(o,index,contexts)
 record=dict(schema='BRIDGE38_HYBRID_QUARTIC_ACCEPTANCE_V6',status='PASS',index=index,n=N,K='0',contract_sha256=CONTRACT_HASH,candidate_sha256=sha256(raw).hexdigest(),passed_cells=passed,empty_cells=empty,all_closed_leaves=len(contexts),maximum_score=str(maximum),target_lower=str(TARGET),negative_controls=nc,source_sha256={name:sha256((HERE/name).read_bytes()).hexdigest()for name in('accept_strict.py','exact_bridge_quartic_core.py','exact_count_core_v5.py','finite_gaussian.py','variance_geometry.py','contract.json','profile.py')})
 dest=HERE/f'accepted_strict_{index}.json';need(not dest.exists(),'fresh acceptance output');dest.write_text(json.dumps(record,indent=2)+'\n')
 print('ACCEPTED_BRIDGE38_HYBRID_QUARTIC',index,passed,empty,len(contexts),nc,float(maximum),round(time.monotonic()-began,2),flush=True)
if __name__=='__main__':main()
